.w{max-width:1200px;margin:0 auto;padding:0 20px}
.sec{padding:56px 0}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 28px;border-radius:999px;background:#FFB400;color:#1a0a08;font-weight:700;text-decoration:none;border:2px solid #FFB400}
.btn:hover{background:#fff;border-color:#fff}
.btn.red{background:#D7261E;color:#fff;border-color:#D7261E}.btn.red:hover{background:#4A0E12;border-color:#4A0E12}
.kal{height:24px;background:url(assets/kalam-border.svg) repeat-x;background-size:auto 24px}
.hd{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #eee}
.hd .w{display:flex;align-items:center;justify-content:space-between;height:64px}
.lg{display:flex;align-items:center;gap:10px;font-weight:800;font-size:19px;color:#1a0a08;text-decoration:none}
.nv{display:none;align-items:center;gap:28px}
.nv a{color:#1a0a08;text-decoration:none;font-weight:500}.nv a:hover{color:#D7261E}
.mm{position:relative}
.mm summary{list-style:none;cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:700;padding:0 18px;border:2px solid #1a0a08;border-radius:999px}
.mm summary::-webkit-details-marker{display:none}
.mm div{position:absolute;right:0;top:54px;background:#fff;border:2px solid #1a0a08;border-radius:20px;padding:8px;min-width:220px;display:flex;flex-direction:column}
.mm a{padding:12px 16px;color:#1a0a08;text-decoration:none;font-weight:600}
.eyebrow{font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:#FFB400}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.chips span{border:1.5px solid rgba(255,255,255,.5);border-radius:999px;padding:6px 14px;font-size:14px}
.tr{display:flex;flex-direction:column;border:2px solid #1a0a08;border-radius:28px;overflow:hidden;background:#fff}
.tr img{width:100%;aspect-ratio:4/3;object-fit:cover}
.tr .b{padding:24px}
.tag{display:inline-block;background:#FFB400;color:#1a0a08;border-radius:999px;padding:2px 12px;font-size:13px;font-weight:700;margin:0 6px 6px 0}
.tr ul{margin:14px 0 20px;padding-left:20px}
.pr{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
.foot a{color:#fff}.foot nav a{display:inline-flex;align-items:center;min-height:44px}[id]{scroll-margin-top:88px}
@media(min-width:768px){
.w{padding:0 40px}.sec{padding:96px 0}
.tr{flex-direction:row}.tr>*{flex:1}.tr:nth-child(even){flex-direction:row-reverse}.tr img{aspect-ratio:auto;height:100%;min-height:380px}.tr .b{padding:44px;display:flex;flex-direction:column;justify-content:center}
.nv{display:flex}.mm{display:none}
}

.skip{position:absolute;left:-999px;top:0;background:#FFB400;color:#1a0a08;padding:12px 16px;z-index:50}.skip:focus{left:0}
