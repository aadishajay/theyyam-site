---
import { waLink } from '../lib/whatsapp';
---
<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false"><path fill="#fff" d="M16.04 3C9.4 3 4 8.38 4 15.01c0 2.37.69 4.58 1.88 6.45L4 29l7.76-1.82a12 12 0 0 0 4.28.79C22.68 27.97 28 22.6 28 15.97 28 9.35 22.68 3 16.04 3Zm0 22.9c-1.4 0-2.77-.3-4-.85l-.28-.14-4.6 1.08 1.1-4.46-.18-.3a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.82-9.8 5.4 0 9.8 4.4 9.8 9.8 0 5.4-4.4 9.87-9.76 9.87Zm5.4-7.35c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.7.3 1.26.48 1.7.62.72.23 1.37.2 1.88.12.57-.08 1.75-.72 2-1.4.25-.7.25-1.3.17-1.4-.07-.13-.27-.2-.57-.35Z"/></svg>
</a>
<style is:global>
  .wa-float { position: fixed; right: 16px; bottom: 16px; z-index: 40; width: 56px; height: 56px; border-radius: 50%; background: #1FAF54; display: grid; place-items: center; box-shadow: 0 6px 18px rgba(0,0,0,.28); border: 0; transition: transform .15s ease; }
  .wa-float:hover { transform: scale(1.07); }
  .wa-float:focus-visible { outline: 3px solid #1a0a08; outline-offset: 3px; }
  /* landing pages show a sticky Enquire bar on phones; sit above it */
  @media (max-width: 767px) { body:has(.bar) .wa-float { bottom: 88px; } }
  @media (prefers-reduced-motion: reduce) { .wa-float { transition: none; } }
  @media print { .wa-float { display: none; } }
</style>
