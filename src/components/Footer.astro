---
import Logo from './Logo.astro';
import { u, type Lang } from '../lib/site';
import { ui } from '../i18n/ui';
import contact from '../data/contact.json';
interface Props {
  lang?: Lang;
  /** text under the logo; defaults to the standard company line */
  about?: string;
  /** photo credit line */
  credit?: string;
  /** "powered by LetsGoForACamp" line */
  poweredBy?: string;
  /** closing line */
  closing?: string;
}
const t0 = Astro.props;
const lang = t0.lang ?? 'en';
const t = ui[lang];
const about = t0.about ?? 'TheyyamTrips is run by LetsGoForACamp Travel and Innovation LLP, organising guided Theyyam tours in Kannur, Kasaragod and across North Malabar, Kerala.';
const credit = t0.credit ?? 'Photographs: LetsGoForACamp trips. Some Theyyam pages use Wikimedia Commons images (CC BY / BY-SA), credited on each page.';
const poweredBy = t0.poweredBy ?? 'TheyyamTrips is powered by LetsGoForACamp. Enquiries, confirmation emails and trip support come from LetsGoForACamp (letsgoforacamp.com).';
const closing = t0.closing ?? 'Made with warmth in North Malabar, Kerala · Powered by letsgoforacamp';
---
<footer class="foot" style="background:#4A0E12;color:#fff;padding:48px 0 32px"><div class="w">
  <div style="display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between">
    <div style="max-width:340px"><a href={u('index.html')} aria-label="TheyyamTrips home" style="display:inline-block"><Logo tone="white" height={64} /></a><p style="opacity:.85;margin-top:8px">{about}</p>{contact.offices.map((o) => <p style="opacity:.85;margin-top:6px;font-size:14px"><b>{t[o.key]}:</b> {o.address}</p>)}</div>
    <nav aria-label={t.footer} style="display:flex;flex-direction:column">
      <a href={u('trips.html')}>{t.trips}</a><a href={u('theyyams/')}>{t.theyyams}</a><a href={u('journal.html')}>{t.journal}</a><a href={u('enquire.html')}>{t.enquire}</a>
    </nav>
    <p style="opacity:.85"><a href={`https://wa.me/${contact.phone.replace(/\D/g, '')}`}>{contact.phone}</a><br /><a href={`mailto:${contact.email}`}>{contact.email}</a>{contact.instagram && <><br />{contact.instagram}</>}</p>
  </div>
  <p style="font-size:13px;opacity:.85;margin-top:32px">{credit}</p>
  <p style="font-size:13px;margin:12px 0 0;opacity:.85">{poweredBy}</p>
  <p style="font-size:13px;margin:12px 0 0;opacity:.7">{closing} · <a href={u('privacy.html')}>Privacy policy</a></p>
</div></footer>
