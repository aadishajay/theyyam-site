---
import { getEntry } from 'astro:content';
import { u, type Lang } from '../lib/site';
import { ui } from '../i18n/ui';
interface Props {
  lang: Lang;
  /** shown when no testimonial is published yet */
  placeholder: { quote: string; by: string };
}
const { lang, placeholder } = Astro.props;
const t = ui[lang];
const data = (await getEntry('testimonials', 'testimonials'))?.data;
const slides = (data?.items ?? []).filter((i) => i.published && i.theyyam).map((i) => ({ ...i, cover: data!.trips[i.trip] }));
---
<section class="sec tcar" style="background:#FFB400" aria-roledescription="carousel" aria-label={t.tLabel}>
  <div class="w">
    {slides.length === 0 ? (
      <div style="max-width:860px;margin:0 auto;text-align:center">
        <p style="font-size:clamp(1.3rem,5vw,2rem);font-weight:700;line-height:1.35">{placeholder.quote}</p>
        <p style="margin-top:16px;font-weight:500">{placeholder.by}</p>
      </div>
    ) : (
      <>
        <div class="tslides">
          {slides.map((s, i) => (
            <figure class={i === 0 ? 'tslide on' : 'tslide'} aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} aria-hidden={i === 0 ? undefined : 'true'}>
              <img src={u(`assets/testimonials/${s.cover.image}`)} alt={s.cover.alt} width="1000" height="750" loading={i === 0 ? undefined : 'lazy'} />
              <div class="tq">
                <blockquote>“{s.quote}”</blockquote>
                <figcaption>{s.label}, {s.date}</figcaption>
              </div>
            </figure>
          ))}
        </div>
        {slides.length > 1 && (
          <div class="tctl">
            <button type="button" class="tprev" aria-label={t.tPrev}>‹</button>
            <div class="tdots">{slides.map((_, i) => <button type="button" class={i === 0 ? 'on' : ''} aria-label={`${t.tGo} ${i + 1}`} data-i={i} />)}</div>
            <button type="button" class="tnext" aria-label={t.tNext}>›</button>
          </div>
        )}
      </>
    )}
  </div>
</section>
<style>
  .tslides { display: grid; }
  .tslide { grid-area: 1 / 1; margin: 0; display: flex; flex-direction: column; gap: 24px; align-items: center; opacity: 0; visibility: hidden; transition: opacity .8s ease, visibility .8s; }
  .tslide.on { opacity: 1; visibility: visible; }
  .tslide img { width: 100%; height: auto; max-width: 420px; aspect-ratio: 4/3; object-fit: cover; border-radius: 24px; border: 4px solid #1a0a08; }
  .tq { text-align: center; max-width: 640px; }
  .tq blockquote { margin: 0; font-size: clamp(1.25rem, 4.6vw, 1.9rem); font-weight: 700; line-height: 1.35; }
  .tq figcaption { margin-top: 16px; font-weight: 500; }
  .tctl { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 28px; }
  .tctl button { cursor: pointer; font: inherit; }
  .tprev, .tnext { width: 44px; height: 44px; border-radius: 999px; border: 2px solid #1a0a08; background: #fff; color: #1a0a08; font-size: 22px; line-height: 1; }
  .tprev:hover, .tnext:hover { background: #1a0a08; color: #fff; }
  .tdots { display: flex; gap: 4px; }
  .tdots button { width: 44px; height: 44px; background: none; border: 0; padding: 0; display: grid; place-items: center; }
  .tdots button::before { content: ''; width: 12px; height: 12px; border-radius: 50%; border: 2px solid #1a0a08; background: transparent; }
  .tdots button.on::before { background: #1a0a08; }
  @media (min-width: 768px) {
    .tslide { flex-direction: row; gap: 48px; justify-content: center; }
    .tslide img { max-width: 440px; flex: 0 0 440px; }
    .tq { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .tslide { transition: none; } }
</style>
<script is:inline>
(function(){
  var root=document.querySelector('.tcar');if(!root)return;
  var s=[].slice.call(root.querySelectorAll('.tslide')),d=[].slice.call(root.querySelectorAll('.tdots button')),n=s.length,i=0,timer=null;
  if(n<2)return;
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function show(k){k=(k+n)%n;s[i].classList.remove('on');s[i].setAttribute('aria-hidden','true');d[i].classList.remove('on');
    s[k].classList.add('on');s[k].removeAttribute('aria-hidden');d[k].classList.add('on');
    var im=s[(k+1)%n].querySelector('img');if(im&&im.loading==='lazy')im.loading='eager';i=k;}
  function start(){if(!timer&&!reduce&&!document.hidden)timer=setInterval(function(){show(i+1)},7000);}
  function stop(){clearInterval(timer);timer=null;}
  root.querySelector('.tprev').addEventListener('click',function(){show(i-1);stop();});
  root.querySelector('.tnext').addEventListener('click',function(){show(i+1);stop();});
  d.forEach(function(b){b.addEventListener('click',function(){show(+b.getAttribute('data-i'));stop();});});
  root.addEventListener('mouseenter',stop);root.addEventListener('mouseleave',start);root.addEventListener('focusin',stop);root.addEventListener('focusout',start);
  document.addEventListener('visibilitychange',function(){document.hidden?stop():start();});
  if('IntersectionObserver' in window){new IntersectionObserver(function(e){e[0].isIntersecting?start():stop();},{threshold:.3}).observe(root);}else{start();}
})();
</script>
