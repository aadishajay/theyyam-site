---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u } from '../lib/site';
import { breadcrumb } from '../lib/schema';
import '../styles/enquire.css';

// Form handler (Cloudflare Worker, POST /submit writes to Notion and emails the guest). The reCAPTCHA v2 site key is public;
// set PUBLIC_RECAPTCHA_SITE_KEY at build time. The key must allow this site's domain.
const ENDPOINT = 'https://lgfc_custom_trip_form_handler.letsgoforacamp.workers.dev/submit';
---
<Base
  title="Enquire About a Theyyam Tour | LGFC Theyyam"
  description="Tell us how you want to travel. We reply within two working days with a Theyyam trip suggestion and a quote. No online checkout."
  path="enquire.html"
  ld={[breadcrumb([['Home', ''], ['Enquire', 'enquire.html']])]}
>
  <Header current="enquire" />
  <main id="main">
<section style="background:#4A0E12;color:#fff"><div class="w" style="padding-top:36px;padding-bottom:44px">
<nav aria-label="Breadcrumb" style="font-size:14px;margin-bottom:18px;opacity:.85"><a href={u("index.html")} style="color:#fff">Home</a> / Plan your trip</nav>
<h1>Plan your Theyyam trip</h1>
<p style="font-size:18px;margin-top:18px;max-width:600px;opacity:.92">Every trip is planned with you, so there is no online checkout. Tell us how you want to travel and we reply within two working days with a suggestion and a quote.</p>
</div><div class="kal"></div></section>

<div class="w lay">
<div class="main">
<p style="font-size:14px;margin:0 0 16px">Fields marked * are required.</p>
<form id="enq" action="#" method="post" class="fm" novalidate>
<div class="f"><label for="name">Full name <span aria-hidden="true">*</span></label><input id="name" name="name" type="text" autocomplete="name" required /></div>
<div class="f"><label for="email">Email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required /></div>
<div class="f"><label for="phone">WhatsApp number</label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 …" /></div>
<div class="f"><label for="arrivaldate">Tentative arrival date <span aria-hidden="true">*</span></label><input id="arrivaldate" name="arrivaldate" type="date" required /></div>
<div class="f"><label for="departuredate">Tentative departure date <span aria-hidden="true">*</span></label><input id="departuredate" name="departuredate" type="date" required /></div>
<label class="full" style="grid-column:1/-1;display:flex;gap:12px;align-items:center;font-size:15px"><input type="checkbox" id="flex" style="width:24px;height:24px;flex:none;accent-color:#D7261E" /> My dates are flexible</label>
<div class="f"><label for="destination">Destination (base town) <span aria-hidden="true">*</span></label><select id="destination" name="destination" required><option value="North Malabar">Not sure yet (North Malabar)</option><option>Kannur</option><option>Kanhangad</option><option>Thalassery</option><option>Payyannur</option></select></div>
<div class="f"><label for="trip">Trip you are interested in</label><select id="trip" name="tripsel"><option value="">Not sure yet</option><option value="one-night">A Night at the Kavu (1 night)</option><option value="two-nights">Two Nights in Kolathunadu (2 nights)</option><option value="immersion">North Malabar Deep Immersion (3+ days)</option><option value="custom">Private or custom trip</option></select></div>
<div class="f"><label for="adults">Number of travellers</label><input id="adults" name="adults" type="number" min="1" value="2" inputmode="numeric" /></div>
<details class="full more" style="grid-column:1/-1;border:2px solid #1a0a08;border-radius:16px;padding:0 18px"><summary style="padding:16px 0;font-size:16px">Add more detail (optional)</summary>
<div class="fm" style="padding-bottom:18px">
<div class="f"><label for="style">How would you like to travel?</label><select id="style" name="style"><option>Not sure yet</option><option>Join a small group</option><option>Private group (friends or family)</option><option>Fully customised itinerary</option></select></div>
<div class="f"><label for="country">Travelling from</label><input id="country" name="country" type="text" autocomplete="country-name" /></div>
<div class="f"><label for="kids">Children (with ages)</label><input id="kids" name="kids" type="text" placeholder="e.g. 1 child, 9" /></div>
<div class="f"><label for="src">How did you hear about us?</label><input id="src" name="src" type="text" /></div>
<div class="f full"><label for="notes">Anything we should know?</label><textarea id="notes" name="notes" placeholder="Interests, mobility needs, budget range"></textarea></div>
</div></details>
<input type="hidden" name="totalpax" /><input type="hidden" name="adultpax" /><input type="hidden" name="stayType" /><input type="hidden" name="datefixed" /><input type="hidden" name="planplaces" /><input type="hidden" name="specialreq" /><input type="hidden" name="rooms" /><input type="hidden" name="kidsage" /><input type="hidden" name="budget" /><input type="hidden" name="intent" value="estimate_first" /><input type="hidden" name="g-recaptcha-response" value="not-used" />
<div aria-hidden="true" style="position:absolute;left:-9999px"><label>Leave this empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
<label class="full" style="grid-column:1/-1;display:flex;gap:12px;align-items:flex-start;font-size:14px"><input type="checkbox" name="consent" required style="width:24px;height:24px;flex:none;margin-top:2px;accent-color:#D7261E" /> I agree to LGFC contacting me about this enquiry. We never share your details. See [PRIVACY POLICY].</label>
<div class="f" style="grid-column:1/-1;max-width:320px"><label for="mathq">Quick check: what is <span id="mq">…</span>? <span aria-hidden="true">*</span></label><input id="mathq" type="text" inputmode="numeric" autocomplete="off" required /></div>
<p id="err" role="alert" hidden style="grid-column:1/-1;color:#b00020;font-weight:600"></p>
<div style="grid-column:1/-1"><button id="go" class="btn" type="submit" style="width:100%;max-width:320px">Send my enquiry</button><p style="font-size:14px;margin-top:10px;opacity:.8">No payment now. We reply within two working days.</p></div>
</form>
<div id="sent" hidden tabindex="-1" style="padding:28px;border:2px solid #1a0a08;border-radius:20px"><h2 style="font-size:1.6rem">Thank you, we have your enquiry</h2><p style="margin-top:12px">A member of our North Malabar team will reply within two working days with a first suggestion. Nothing is charged and nothing is booked yet.</p><p id="review" hidden style="margin-top:12px;font-weight:600">Review build: nothing was sent. The live site will deliver your enquiry to our team.</p><p style="margin-top:16px"><a class="btn red" href={u("what-is-theyyam.html")}>While you wait: what is Theyyam?</a></p></div>
<script is:inline define:vars={{ ENDPOINT, SUCCESS: u('enquiry-success.html') }}>
(function(){
var f=document.getElementById('enq'),err=document.getElementById('err'),go=document.getElementById('go');
window.dataLayer=window.dataLayer||[];function track(e){window.dataLayer.push({event:e});}
var q=new URLSearchParams(location.search),t=q.get('trip');
if(t){var o=f.querySelector('#trip option[value="'+t.replace(/[^a-z-]/g,'')+'"]');if(o)f.tripsel.value=o.value;}
var today=new Date().toISOString().slice(0,10);f.arrivaldate.min=today;f.departuredate.min=today;
f.arrivaldate.addEventListener('change',function(){if(f.arrivaldate.value){f.departuredate.min=f.arrivaldate.value;if(!f.departuredate.value||f.departuredate.value<f.arrivaldate.value)f.departuredate.value=f.arrivaldate.value;}});
var started=false;f.addEventListener('input',function(){if(!started){started=true;track('enquiry_start');}});
var ans=0;function newQ(){var a=2+Math.floor(Math.random()*8),b=2+Math.floor(Math.random()*8);ans=a+b;document.getElementById('mq').textContent=a+' + '+b;}newQ();
function fail(m,el){err.textContent=m;err.hidden=false;if(el)el.focus();}
f.addEventListener('submit',function(ev){
 ev.preventDefault();err.hidden=true;
 if(f.company.value)return;
 if(!f.name.value.trim())return fail('Please add your name.',f.name);
 if(!/^\S+@\S+\.\S+$/.test(f.email.value.trim()))return fail('Please add a valid email.',f.email);
 if(!f.arrivaldate.value||!f.departuredate.value)return fail('Please choose an arrival and departure date. Approximate is fine, tick "My dates are flexible".',f.arrivaldate.value?f.departuredate:f.arrivaldate);
 if(f.departuredate.value<f.arrivaldate.value)return fail('Departure cannot be before arrival.',f.departuredate);
 if(!f.consent.checked)return fail('Please tick the consent box.',f.consent);
 if(parseInt(f.mathq.value,10)!==ans){newQ();f.mathq.value='';return fail('That answer is not right. Please try the new sum.',f.mathq);}
 var n=Math.max(1,parseInt(f.adults.value,10)||1),trip=f.tripsel.options[f.tripsel.selectedIndex].text;
 f.totalpax.value=n;f.adultpax.value=n;f.rooms.value=Math.ceil(n/2);
 f.stayType.value=f.style.value;
 f.datefixed.value=f.flex.checked?'No, dates are flexible':'Yes';
 f.planplaces.value=trip;
 f.kidsage.value=f.kids.value;
 f.specialreq.value=[f.notes.value,f.country.value&&('From: '+f.country.value),f.src.value&&('Heard about us: '+f.src.value)].filter(Boolean).join('\n');
 go.disabled=true;go.textContent='Sending…';track('enquiry_submit');
 var dest='Theyyam- '+f.destination.value,body=new FormData(f);body.set('destination',dest);body.delete('company');body.delete('tripsel');body.delete('consent');
 var id=(f.name.value.trim().slice(0,4)+'/'+dest.slice(0,4)+'/'+f.arrivaldate.value).toUpperCase();
 fetch(ENDPOINT,{method:'POST',mode:'no-cors',body:body})
 .then(function(){track('enquiry_submit');location.href=SUCCESS+'?enquiryId='+encodeURIComponent(id);})
 .catch(function(){go.disabled=false;go.textContent='Send my enquiry';fail('Sorry, that did not send. Please check your connection and try again.');});
});
})();
</script>
</div>
<aside aria-label="What happens next">
<img src={u("assets/lgfc-face-closeup.jpg")} alt="Close portrait of a Theyyam with orange face, silver ornaments and a white fringe" width="500" height="420" style="width:100%;height:240px;object-fit:cover;border-radius:28px 28px 0 0" />
<div style="background:#FFB400;border-radius:0 0 28px 28px;padding:28px">
<h2>What happens next</h2>
<ol style="margin:16px 0 0;padding-left:20px;display:flex;flex-direction:column;gap:10px"><li><b>We read your enquiry</b> and match it to the season.</li><li><b>You get a proposal</b> in two working days.</li><li><b>We confirm the rituals</b> closer to travel, then you pay.</li></ol>
<hr style="border:0;border-top:2px solid #1a0a08;margin:22px 0" />
<h3>Prefer to talk?</h3><p style="margin-top:6px">WhatsApp: [PHONE]<br />Email: [EMAIL]</p><p style="margin-top:10px;font-size:14px">8+ years organising Theyyam tours · 500+ explorers hosted · 24x7 support on booked trips. Replies come from our North Malabar team, not a call centre.</p>
</div>
</aside>
</div>
</main>
  <Footer credit="Photograph: LetsGoForACamp trips." />
</Base>
