---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Cta from '../components/Cta.astro';
import terms from '../data/glossary.json';
import { u } from '../lib/site';
import { breadcrumb } from '../lib/schema';
import '../styles/theyyam.css';

const slug = (n: string) => n.toLowerCase().replace(/[^a-z]/g, '-');
const strip = (h: string) => h.replace(/<[^>]+>/g, '');
const ld = [
  breadcrumb([['Home', ''], ['Theyyam words explained', 'theyyam-glossary.html']]),
  { '@type': 'DefinedTermSet', name: 'Theyyam words explained', hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.name, description: strip(t.html) })) },
];
---
<Base wrap={false}
  title="Theyyam Words Explained: Kaliyattam, Ottakolam, Mudi & More | TheyyamTrips"
  description="Plain-English meanings of Theyyam words you will hear in North Malabar: kaliyattam, perumkaliyattam, ottakolam, thottam, mudi, kavu and more."
  path="theyyam-glossary.html"
  ld={ld}
>
  <Header />
  <main id="main"><article><div class="w"><div class="art sec">
    <Breadcrumb items={[['Home', 'index.html'], ['Theyyam words explained']]} style="font-size:14px;margin:24px 0 18px" />
    <h1>Theyyam words explained</h1>
    <p style="font-size:1.15em;font-weight:500;margin-top:18px">The words you will hear around a ritual in North Malabar, in plain English. Meanings can vary by shrine and family, so treat these as a starting point and ask your guide.</p>
    {terms.map((t) => (
      <>
        <h2 id={slug(t.name)}>{t.name}</h2>
        <p><Fragment set:html={t.html} />{t.source && <> <span style="font-size:13px;opacity:.75">Source: <a href={t.source.url} rel="noopener">{t.source.name}{t.source.url.includes('wikipedia') ? ' (Wikipedia)' : ''}</a>.</span></>}</p>
      </>
    ))}
    <div class="cta" style="margin-top:36px"><h3>Hear the stories in person</h3><p>Our guided trips explain each word and each deity as you see it. <a href={u('theyyams/')}>Browse the Theyyams</a> or enquire about a trip.</p><a class="btn" href={u('enquire.html')}>Enquire about a trip</a></div>
  </div></div></article></main>
  <Footer />
</Base>
